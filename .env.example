# Database Configuration
# برای حالت لوکال و بدون داکر: sqlite+aiosqlite:///./clash_rack.db
# برای استقرار در سرور داکر: postgresql+asyncpg://postgres:postgres@db:5432/clash_rack
DATABASE_URL=sqlite+aiosqlite:///./clash_rack.db

# Business Logic Settings
RESERVATION_HOLD_MINUTES=15
RENTAL_REMINDER_HOURS=2,24
MAINTENANCE_MODE=false

# Texts
WELCOME_MESSAGE="سلام به سامانه اجاره رک کلش خوش آمدید! ⚡️\nاز طریق منوی زیر می‌توانید انواع رک‌های دونیت، وار و مکس را مشاهده و به صورت آنی اجاره کنید."
